# À copier sur le serveur dans /etc/cashpay-recruitment.env, droits 0600.
# Ne jamais versionner le fichier rempli.
HOST=127.0.0.1
PORT=3100
SITE_ORIGIN=https://cashpay-all.com
# Le service ne fait confiance aux en-têtes transférés que depuis ces adresses.
TRUST_PROXY_IPS=127.0.0.1,::1
RECRUITMENT_DATA_DIR=/var/lib/cashpay-recruitment
RECRUITMENT_TO=info@cashpayall.com
RECRUITMENT_RETENTION_DAYS=180

# Renseigner avec les paramètres du serveur SMTP de votre messagerie.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
