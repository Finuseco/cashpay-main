[Unit]
Description=CashPay All — relance des notifications de candidature
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cashpay-recruitment
Group=cashpay-recruitment
WorkingDirectory=/var/www/cashpay-all/main
EnvironmentFile=/etc/cashpay-recruitment.env
ExecStart=/usr/bin/node recruitment-server/worker.mjs
StateDirectory=cashpay-recruitment
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cashpay-recruitment
